# AI provider selection: "openrouter" or "groq"
AI_PROVIDER=openrouter

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (https://openrouter.ai/keys) — any model id supported
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5

# Cache time-to-live for yfinance responses (seconds)
CACHE_TTL_SECONDS=900

# Timeout for a single yfinance retrieval (seconds)
YFINANCE_TIMEOUT_SECONDS=30

# Timeout for the AI analysis call (seconds)
AI_TIMEOUT_SECONDS=120
