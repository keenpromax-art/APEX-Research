# AI provider selection: "gemini", "openrouter", or "groq"
AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5

# Cache time-to-live for yfinance responses (seconds)
CACHE_TTL_SECONDS=900

# Timeout for a single yfinance retrieval (seconds)
YFINANCE_TIMEOUT_SECONDS=30

# Timeout for the AI analysis call (seconds)
AI_TIMEOUT_SECONDS=120
