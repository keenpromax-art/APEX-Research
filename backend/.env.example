# APEX Terminal backend environment
# Copy to .env and fill in values. Never commit real keys.

APP_ENV=development
# SQLite by default; for PostgreSQL install "psycopg[binary]" and use:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/apex
DATABASE_URL=sqlite:///./apex.db
SECRET_KEY=change-me-in-production-please-32chars
CORS_ORIGINS=http://localhost:3000

# --- AI providers (all optional; servers keep keys, browser never sees them) ---
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA NIM / integrate.api.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Task routing defaults
DEFAULT_AI_PROVIDER=openrouter
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Data
YFINANCE_TIMEOUT=30
CACHE_TTL_SECONDS=3600

# Partner API administration. If empty, partner admin endpoints are disabled.
PARTNER_ADMIN_TOKEN=
